<Project>

  <!--
    Single source of truth for the product version (backend and frontend).

    Every project under backend/ inherits <Version> from here — no .csproj should
    declare its own. frontend/package.json mirrors this value, and
    scripts/check-version.mjs fails CI if the two diverge.

    On a release PR, the bump happens here and in package.json — nowhere else.
  -->
  <PropertyGroup>
    <Version>0.0.2</Version>
  </PropertyGroup>

</Project>
